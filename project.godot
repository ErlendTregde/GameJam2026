[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="boat_hull"
3d_physics/layer_3="boat_deck"
3d_physics/layer_4="player"
3d_physics/layer_5="interactables"
3d_physics/layer_6="creatures"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=2048
scaling_3d/mode=1
scaling_3d/scale=0.8
environment/glow/upscale_mode=0

[shader_globals]

style_shadow_color={
"type": "color",
"value": Color(0.42, 0.45, 0.72, 1)
}
style_shadow_softness={
"type": "float",
"value": 0.08
}
style_rim_strength={
"type": "float",
"value": 0.6
}
style_saturation={
"type": "float",
"value": 1.1
}

[steam]

initialization/app_data/app_id=480
