; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spearfish with me"
run/main_scene="res://scenes/ui/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AppFlow="*res://autoloads/session/app_flow.gd"
SteamState="*res://autoloads/network/steam_state.gd"
P2P="*res://autoloads/network/p2p.gd"
SteamManager="*res://autoloads/network/steam_manager.gd"
RoomService="*res://autoloads/session/room_service.gd"
VoiceChatService="*res://autoloads/voice/voice_chat_service.gd"
WorldService="*res://autoloads/gameplay/world_service.gd"
ItemService="*res://autoloads/gameplay/item_service.gd"
CreatureService="*res://autoloads/gameplay/creature_service.gd"
WorldEvents="*res://autoloads/gameplay/world_events.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

