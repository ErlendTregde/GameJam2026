[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/main_menu/main_menu.gd" id="1_menu"]
[ext_resource type="PackedScene" path="res://scenes/main.tscn" id="2_world"]
[ext_resource type="Theme" path="res://scenes/ui/ui_theme.tres" id="3_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/credits/credits.tscn" id="4_credits"]

[node name="MainMenu" type="Node3D"]
script = ExtResource("1_menu")

[node name="World" parent="." instance=ExtResource("2_world")]

[node name="Camera" type="Camera3D" parent="."]
fov = 60.0

[node name="UI" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="UI"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("3_theme")

[node name="Menu" type="VBoxContainer" parent="UI/Root"]
layout_mode = 1
anchors_preset = 4
anchor_top = 0.5
anchor_bottom = 0.5
offset_left = 90.0
offset_top = -250.0
offset_right = 560.0
offset_bottom = 250.0
grow_vertical = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="UI/Root/Menu"]
layout_mode = 2
theme_override_constants/outline_size = 16
theme_override_font_sizes/font_size = 64
text = "Spearfish
with me"

[node name="Status" type="Label" parent="UI/Root/Menu"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
autowrap_mode = 3

[node name="HostButton" type="Button" parent="UI/Root/Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Host"

[node name="JoinRow" type="HBoxContainer" parent="UI/Root/Menu"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="JoinCode" type="LineEdit" parent="UI/Root/Menu/JoinRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Lobby ID or IP address"
max_length = 40

[node name="JoinButton" type="Button" parent="UI/Root/Menu/JoinRow"]
custom_minimum_size = Vector2(120, 54)
layout_mode = 2
text = "Join"

[node name="SoloButton" type="Button" parent="UI/Root/Menu"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Play solo"

[node name="CreditsButton" type="Button" parent="UI/Root/Menu"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Credits"

[node name="QuitButton" type="Button" parent="UI/Root/Menu"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
text = "Quit"

[node name="Credits" parent="UI/Root" instance=ExtResource("4_credits")]
visible = false
layout_mode = 1

[connection signal="pressed" from="UI/Root/Menu/CreditsButton" to="." method="_on_credits_pressed"]
[connection signal="closed" from="UI/Root/Credits" to="." method="_on_credits_closed"]
[connection signal="pressed" from="UI/Root/Menu/HostButton" to="." method="_on_host_pressed"]
[connection signal="pressed" from="UI/Root/Menu/JoinRow/JoinButton" to="." method="_on_join_pressed"]
[connection signal="text_submitted" from="UI/Root/Menu/JoinRow/JoinCode" to="." method="_on_join_pressed" unbinds=1]
[connection signal="pressed" from="UI/Root/Menu/SoloButton" to="." method="_on_solo_pressed"]
[connection signal="pressed" from="UI/Root/Menu/QuitButton" to="." method="_on_quit_pressed"]
