[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/credits/credits.gd" id="1_credits"]
[ext_resource type="Theme" path="res://scenes/ui/ui_theme.tres" id="2_theme"]

[node name="Credits" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_credits")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.45, 0.75, 0.95, 0.25)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 90.0
offset_top = 50.0
offset_right = -90.0
offset_bottom = -50.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="Rows" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Top" type="HBoxContainer" parent="Panel/Margin/Rows"]
layout_mode = 2

[node name="Title" type="Label" parent="Panel/Margin/Rows/Top"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/outline_size = 14
theme_override_font_sizes/font_size = 48
text = "Credits"

[node name="BackButton" type="Button" parent="Panel/Margin/Rows/Top"]
custom_minimum_size = Vector2(160, 54)
layout_mode = 2
text = "Back"

[node name="Thanks" type="Label" parent="Panel/Margin/Rows"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Spearfish with me is made with these wonderful free assets. Thank you to every creator!"
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="Panel/Margin/Rows"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Panel/Margin/Rows/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[connection signal="pressed" from="Panel/Margin/Rows/Top/BackButton" to="." method="_on_back_pressed"]
